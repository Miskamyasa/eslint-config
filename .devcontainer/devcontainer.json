{
  "name": "eslint-config",
  "image": "miskamyasa/mise-ub-24-04",
  "remoteUser": "ubuntu",
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "${localWorkspaceFolder}",
    "MISE_ENV": "dev",
    "PNPM_STORE_DIR": "${localEnv:PNPM_STORE_DIR}",
    "MEMORY_MCP_TOKEN": "${localEnv:MEMORY_MCP_TOKEN}",
    "CPA_BASE_URL": "http://host.docker.internal:8317"
  },
  "mounts": [
    // Cache mounts
    "source=${localEnv:HOME}/.cache/containers/cache,target=/home/ubuntu/.cache,type=bind",
    "source=${localEnv:HOME}/.cache/containers/local-share,target=/home/ubuntu/.local/share,type=bind",
    // pnpm store mount
    "source=${localEnv:PNPM_STORE_DIR},target=${localEnv:PNPM_STORE_DIR},type=bind",
    // Pi
    "source=${localEnv:HOME}/.pi/agent,target=/home/ubuntu/.pi/agent,type=bind",
  ],
  "runArgs": [
    "--name=eslint-config"
  ],
  "postCreateCommand": "mise self-update -y && mise install"
}
