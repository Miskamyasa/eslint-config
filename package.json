{
  "author": "Denis <MiskaMyasa> Zaitsev",
  "bugs": {
    "url": "https://github.com/Miskamyasa/eslint-config/issues"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsonc-eslint-parser": "3.3.0",
    "typescript-eslint": "8.72.1"
  },
  "description": "Opinionated ESLint config for React + TypeScript projects",
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "^10.13.0",
    "jiti": "2.7.0",
    "tsdown": "0.23.4",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Miskamyasa/eslint-config",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "stylistic"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@miskamyasa/eslint-config",
  "packageManager": "pnpm@12.11.2",
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "typescript": ">=5.0.0 && <7.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://github.com/Miskamyasa/eslint-config.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2.0.2"
}
